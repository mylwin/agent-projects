# 应用配置
APP_NAME=安心保
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8001

# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=insurance
DB_PASSWORD=insurance123
DB_NAME=insurance

# 大模型配置
DEEPSEEK_API_KEY=sk-replace-with-your-key
CHAT_MODEL=deepseek-flash

# MinerU 解析服务
MINERU_TOKEN=sk-replace-with-your-token

# Milvus 向量库
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530

# JWT 签名密钥：至少 32 字符，请勿提交真实值
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=please-generate-a-random-secret-at-least-32-chars
# 访问令牌有效期（分钟）
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# 刷新令牌有效期（天）
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# HTTPS 部署时设为 true，本地 HTTP 开发设为 false
JWT_REFRESH_COOKIE_SECURE=false
