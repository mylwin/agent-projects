          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="channel_versions 关联" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeColor=#4f5d75;fontSize=12;labelBackgroundColor=#f5f5f5;dashed=1;" edge="1" parent="1" source="cp" target="blobs">
