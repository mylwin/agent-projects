# 支持工具调用的 OpenAI 兼容模型服务；默认使用百炼北京地域。
MODEL_API_KEY=
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus
# 单次模型请求超时秒数，含首次带工具定义的大请求；可留空使用默认 60。
MODEL_TIMEOUT_SECONDS=60
# 整轮规划总超时秒数；可留空使用默认 300。
PLANNER_TIMEOUT_SECONDS=300
# 思考链开关：auto（默认，不发送该参数）/ true / false。
# 仅推理模型（Qwen3、DeepSeek-R1 等）支持；关闭可明显缩短首字等待时间。
# 需要看到终端里的 [思考] 过程时设为 true，并确认所选模型会返回 reasoning_content；
# 默认的 qwen-plus 通常不是思考型模型，只会显示阶段、回复和工具事件。
MODEL_ENABLE_THINKING=auto
# 思考链最大 token 数，可留空；Qwen3 系列达到预算会强制结束思考。
MODEL_THINKING_BUDGET=

# 地图供应商：amap（高德，默认）或 baidu（百度）。
MAP_PROVIDER=amap
# 只需填写选中供应商的 Web 服务密钥。
AMAP_API_KEY=
BAIDU_MAP_API_KEY=
