# 支持工具调用的 OpenAI 兼容模型服务；默认使用百炼北京地域。
MODEL_API_KEY=
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus
# 单次模型请求超时秒数，含首次带工具定义的大请求；可留空使用默认 60。
MODEL_TIMEOUT_SECONDS=60
# 三个研究 Agent 加 Planner 的整轮超时秒数；可留空使用默认 300。
PLANNER_TIMEOUT_SECONDS=300
# 可选供应商思考参数；auto 不发送该参数，true 仅请求启用模型思考。
# 统一使用 ChatOpenAI；能否显示推理取决于 SDK 是否透传，正文与工具进度始终可见。
MODEL_ENABLE_THINKING=auto
MODEL_THINKING_BUDGET=

# 地图供应商：amap（高德，默认）或 baidu（百度）。
MAP_PROVIDER=amap
# 只需填写选中供应商密钥，须具备官方地图 MCP 服务权限；不再调用手写 REST 客户端。
AMAP_API_KEY=
BAIDU_MAP_API_KEY=

# MySQL 连接；填写 DB_NAME 后启用，数据库与表需提前创建。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# 登录 Cookie 的签名密钥；至少 32 字节，生产环境使用随机值并启用 HTTPS。
AUTH_SECRET_KEY=
AUTH_COOKIE_SECURE=false
